<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MetadataEditor" Width="1400" Height="800" Background="White"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style x:Key="TB" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E8EEF5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#555"/>
      <Setter Property="Margin" Value="0,10,0,2"/>
    </Style>
    <Style x:Key="Fld" TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="4,4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderBrush" Value="#999"/>
    </Style>
      <GridView x:Key="detailsView" AllowsColumnReorder="False">
      <GridViewColumn Header="Name" Width="340" DisplayMemberBinding="{Binding Name}"/>
      <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Badge}"/>
      <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
      <GridViewColumn Header="Created" Width="150" DisplayMemberBinding="{Binding CreatedText}"/>
    </GridView>
    <ItemsPanelTemplate x:Key="tilePanel"><WrapPanel/></ItemsPanelTemplate>
    <DataTemplate x:Key="tileTemplate">
      <StackPanel Margin="8,6" HorizontalAlignment="Center">
        <Grid Width="100" Height="100">
          <Border CornerRadius="8" Background="{Binding BadgeColor}">
            <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
        </Grid>
        <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" Width="136" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0" FontSize="16" TextWrapping="Wrap" MaxHeight="46"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="tileStyle" TargetType="ListViewItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" Width="152" Height="178" Margin="1" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#F0F7FF"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E3F2FD"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#90CAF9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <DockPanel Grid.Row="0" Margin="8,6,8,4" LastChildFill="False">
      <Button x:Name="btnBack" Content="&#x2039;" Style="{StaticResource TB}" FontSize="16" Width="34"/>
      <Button x:Name="btnFwd" Content="&#x203A;" Style="{StaticResource TB}" FontSize="16" Width="34"/>
      <Button x:Name="btnNew" Content="New" Style="{StaticResource TB}" Margin="14,0,0,0"/>
      <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource TB}" FontWeight="SemiBold"/>
      <Button x:Name="btnCut" Content="Cut" Style="{StaticResource TB}"/>
      <Button x:Name="btnCopy" Content="Copy" Style="{StaticResource TB}"/>
      <Button x:Name="btnPaste" Content="Paste" Style="{StaticResource TB}"/>
      <Button x:Name="btnCopyTo" Content="Copy To" Style="{StaticResource TB}"/>
      <Button x:Name="btnMoveTo" Content="Move To" Style="{StaticResource TB}"/>
      <RadioButton x:Name="rbDetails" Content="Details" GroupName="v" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0,0,0"/>
      <RadioButton x:Name="rbThumbs" Content="Thumbnails" GroupName="v" FontSize="12" FontWeight="SemiBold" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"/>
      <TextBox x:Name="txtSearch" DockPanel.Dock="Right" Width="180" Height="26" VerticalContentAlignment="Center" BorderBrush="#999"/>
      <TextBlock Text="&#x1F50D;" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
    </DockPanel>

    <!-- Path bar -->
    <DockPanel Grid.Row="1" Margin="8,2,8,6">
      <TextBlock Text="Path:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="txtPath" IsReadOnly="True" Height="26" VerticalContentAlignment="Center" BorderBrush="#BBB" FontSize="12"/>
    </DockPanel>

    <!-- Main area -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <!-- Left: tree -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="FILES &amp; FOLDERS" FontSize="11" FontWeight="SemiBold" Margin="4,2,0,3"/>
        <TreeView x:Name="tree" BorderBrush="#BBB" FontSize="14"/>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

      <!-- Centre: files -->
      <ListView x:Name="list" Grid.Column="2" SelectionMode="Extended" BorderBrush="#DDD"/>
      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

      <!-- Right: metadata -->
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,0,10,10">
          <TextBlock Text="FILE METADATA" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
          <TextBlock Text="File Name:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtName" Style="{StaticResource Fld}"/>
          <TextBlock Text="Title:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtTitle" Style="{StaticResource Fld}"/>
          <TextBlock Text="Subject:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtSubject" Style="{StaticResource Fld}"/>
          <TextBlock Text="Authors:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtAuthors" Style="{StaticResource Fld}"/>
          <TextBlock Text="Tags:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtTags" Style="{StaticResource Fld}"/>
          <TextBlock Text="Comments:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtComments" Style="{StaticResource Fld}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="Rating (1-5):" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtRating" Style="{StaticResource Fld}"/>
          <Button x:Name="btnSave" Content="SAVE METADATA" Height="38" Margin="0,14,0,0" Background="#1565C0"
                  Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"/>
          <Border Background="#F2F2F2" CornerRadius="4" Padding="8" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="SYSTEM INFO" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock x:Name="sysInfo" FontSize="11" Foreground="#444" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="#CCC" BorderThickness="0,1,0,0" Padding="6,4">
      <TextBlock x:Name="txtStatus" FontSize="14"/>
    </Border>
  </Grid>
</Window>


